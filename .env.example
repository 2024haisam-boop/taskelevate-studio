# ---------------------------------------------------------------------------
# Taskelevate Studios — environment variables
# Copy to .env.local for local development; set the same keys in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else stays server-side.
# ---------------------------------------------------------------------------

# Canonical origin used for metadata, sitemap and structured data
NEXT_PUBLIC_SITE_URL=https://studio.taskelevate.com

# --- Contact form delivery (Resend) — ALL THREE are required for the form to send ---
# https://resend.com → API Keys. The FROM domain must be verified in Resend (add its DNS records).
RESEND_API_KEY=
# Inbox(es) that receive inquiries (comma-separated for several)
CONTACT_TO_EMAIL=
# Verified sender, e.g.  Taskelevate Studios <studio@taskelevate.com>
CONTACT_FROM_EMAIL=

# --- Rate limiting (optional tuning) ---
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
# Recommended in production: shared limit across serverless instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Booking (Calendly). "Book a Discovery Call" buttons are hidden until this is set. ---
# e.g. https://calendly.com/your-handle/discovery-call   (use your REAL link)
NEXT_PUBLIC_BOOKING_URL=

# --- Public contact + social (each link is hidden until set) ---
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# --- Showreel (hero "Watch Reel" button appears only when set) ---
# Either a full URL or a path under /public, e.g. /media/showreel.mp4
NEXT_PUBLIC_SHOWREEL_URL=
NEXT_PUBLIC_SHOWREEL_PATH=
NEXT_PUBLIC_SHOWREEL_POSTER=

# --- Analytics: none | plausible | ga4 (ga4 shows a consent banner and loads only after consent) ---
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted / proxied script URL (optional)
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_GA4_ID=
